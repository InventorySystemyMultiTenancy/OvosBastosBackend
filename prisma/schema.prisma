generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ADMIN
  VENDEDOR
  ENTREGADOR
}

enum TipoMovimentacaoEstoque {
  ENTRADA
  SAIDA
}

enum TipoMovimentacaoBandeja {
  EMPRESTIMO
  DEVOLUCAO
}

enum StatusVenda {
  ORCAMENTO
  CONFIRMADA
  CANCELADA
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO
  BOLETO
  FIADO
}

enum StatusPagamentoPointMP {
  PENDENTE
  EM_PROCESSO
  APROVADO
  REJEITADO
  CANCELADO
}

enum StatusRecebimento {
  EM_ANDAMENTO
  AGUARDANDO_DISTRIBUICAO
  CONCLUIDO
}

enum StatusSessaoCaixa {
  ABERTA
  FECHADA
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    Perfil   @default(VENDEDOR)
  ativo     Boolean  @default(true)
  fotoUrl   String?
  createdAt DateTime @default(now())

  // Login travado a uma unidade (loja) — não a um caixa específico, já que uma unidade
  // pode ter mais de um caixa físico. É texto livre casando com Caixa.unidade (mesmo
  // padrão, sem uma tabela Unidade separada).
  unidade String?

  vendas       Venda[]
  recebimentos Recebimento[]

  sessoesCaixaAbertas  SessaoCaixa[] @relation("SessaoCaixaAbertura")
  sessoesCaixaFechadas SessaoCaixa[] @relation("SessaoCaixaFechamento")
}

model Cliente {
  id            Int      @id @default(autoincrement())
  nome          String
  documento     String?
  telefone      String?
  email         String?
  endereco      String?
  cidade        String?
  limiteCredito Decimal  @default(0) @db.Decimal(12, 2)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  vendas               Venda[]
  bandeja              BandejaCliente?
  movimentacoesBandeja MovimentacaoBandeja[]
  contasReceber        ContaReceber[]
}

model Fornecedor {
  id        Int      @id @default(autoincrement())
  nome      String
  documento String?
  telefone  String?
  email     String?
  endereco  String?
  cidade    String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  recebimentos Recebimento[]
  precos       PrecoFornecedor[]
}

model PrecoFornecedor {
  id            Int        @id @default(autoincrement())
  fornecedorId  Int
  fornecedor    Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  produtoId     Int
  produto       Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  precoUnitario Decimal    @db.Decimal(12, 2)
  updatedAt     DateTime   @updatedAt

  @@unique([fornecedorId, produtoId])
}

model Produto {
  id   Int     @id @default(autoincrement())
  nome String
  tipo String?
  // Preço de custo, sempre por grão-base (o grão mais fino vendável deste produto, ex: 1 ovo
  // — ver NivelVendaProduto). Cadastrado na tela "por nível de referência" e convertido pra
  // grão-base ao salvar (ver produtos.controller.js).
  precoCusto Decimal? @db.Decimal(12, 2)
  // Pool central de estoque "recebido e ainda não distribuído" às unidades — não é mais
  // "estoque disponível para venda" quando a venda tem caixa associada (ver EstoqueCaixa).
  // Sempre contado em grão-base (o menor grão vendável do produto — ver NivelVendaProduto).
  quantidade    Int      @default(0)
  estoqueMinimo Int      @default(0)
  imagemUrl     String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  lotes            Lote[]
  movimentacoes    MovimentacaoEstoque[]
  itensVenda       ItemVenda[]
  itensRecebimento ItemRecebimento[]
  estoquePorCaixa  EstoqueCaixa[]
  precosFornecedor PrecoFornecedor[]
  niveisVenda      NivelVendaProduto[]
}

// Um jeito vendável de embalar o mesmo produto (ex: Unidade, Dúzia, Bandeja, Caixa) — não tem
// estoque próprio, todos descontam do mesmo estoque em grão-base do Produto (ver
// ItemVenda.nivelVendaId). Cada produto tem exatamente 1 nível com ehBase=true, cujo `preco`
// é digitado à mão e serve de referência: os demais níveis (precoManual=false) têm seu preço
// recalculado automaticamente (preco = precoBase / quantidadeGraoBase * quantidadeGrao) toda
// vez que o preço base muda. Um nível marcado precoManual=true (por edição direta do usuário,
// ou toda "caixa fechada" com desconto por atacado) para de seguir esse recálculo até alguém
// clicar em "recalcular".
model NivelVendaProduto {
  id            Int      @id @default(autoincrement())
  produtoId     Int
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome          String
  // Quantas unidades do grão-base (ex: ovos) 1 deste nível representa. 1 = o próprio grão-base
  // ("Unidade"). Ex: Dúzia=12, Bandeja=30, Caixa=360.
  quantidadeGrao Int
  preco         Decimal  @db.Decimal(12, 2)
  ehBase        Boolean  @default(false)
  precoManual   Boolean  @default(false)
  // Foto própria deste nível no card do PDV/catálogo — se vazio, usa a imagem do produto (ver
  // resolução no frontend).
  imagemUrl     String?
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())

  itensVenda ItemVenda[]
}

model Lote {
  id         Int      @id @default(autoincrement())
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  quantidade Int
  validade   DateTime
  createdAt  DateTime @default(now())
}

model MovimentacaoEstoque {
  id         Int                     @id @default(autoincrement())
  produtoId  Int
  produto    Produto                 @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  caixaId    Int? // null = movimento no pool central; setado = entrada/saída numa unidade
  caixa      Caixa?                  @relation(fields: [caixaId], references: [id])
  tipo       TipoMovimentacaoEstoque
  quantidade Int
  motivo     String?
  createdAt  DateTime                @default(now())
}

model Recebimento {
  id            Int               @id @default(autoincrement())
  status        StatusRecebimento @default(EM_ANDAMENTO)
  fornecedorId  Int?
  fornecedor    Fornecedor?       @relation(fields: [fornecedorId], references: [id])
  criadoPorId   Int?
  criadoPor     Usuario?          @relation(fields: [criadoPorId], references: [id])
  observacao    String?
  createdAt     DateTime          @default(now())
  finalizadoEm  DateTime?
  distribuidoEm DateTime?

  // Travado (snapshot) ao definir o fornecedor: itens × PrecoFornecedor naquele momento.
  // Editar a tabela de preços depois não muda o valor de entregas já fechadas.
  valorTotal Decimal? @db.Decimal(12, 2)
  valorPago  Decimal  @default(0) @db.Decimal(12, 2)

  itens      ItemRecebimento[]
  pagamentos PagamentoRecebimento[]
}

model PagamentoRecebimento {
  id            Int         @id @default(autoincrement())
  recebimentoId Int
  recebimento   Recebimento @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  valor         Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
}

model ItemRecebimento {
  id                    Int         @id @default(autoincrement())
  recebimentoId         Int
  recebimento           Recebimento @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  produtoId             Int
  produto               Produto     @relation(fields: [produtoId], references: [id])
  quantidadeRecebida    Int
  quantidadeDistribuida Int         @default(0)

  @@unique([recebimentoId, produtoId])
}

model EstoqueCaixa {
  id         Int     @id @default(autoincrement())
  produtoId  Int
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  caixaId    Int
  caixa      Caixa   @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  quantidade Int     @default(0)

  @@unique([produtoId, caixaId])
}

model BandejaCliente {
  id          Int      @id @default(autoincrement())
  clienteId   Int      @unique
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  emprestadas Int      @default(0)
  devolvidas  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model MovimentacaoBandeja {
  id         Int                     @id @default(autoincrement())
  clienteId  Int
  cliente    Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo       TipoMovimentacaoBandeja
  quantidade Int
  // Preenchido só em DEVOLUCAO quando é uma revenda: quanto o cliente cobrou pelas bandejas
  // devolvidas. Vira uma ContaPagar (despesa já paga) pra entrar no lucro líquido.
  valor      Decimal?                @db.Decimal(12, 2)
  createdAt  DateTime                @default(now())
}

model Venda {
  id             Int             @id @default(autoincrement())
  clienteId      Int
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  vendedorId     Int?
  vendedor       Usuario?        @relation(fields: [vendedorId], references: [id])
  caixaId        Int?
  caixa          Caixa?          @relation(fields: [caixaId], references: [id])
  status         StatusVenda     @default(ORCAMENTO)
  formaPagamento FormaPagamento?
  // Preenchido só quando o pagamento foi dividido entre dinheiro e maquininha: quanto saiu
  // em dinheiro — o restante (total - valorDinheiro) é o que vai pra maquininha (CARTAO).
  valorDinheiro  Decimal?        @db.Decimal(12, 2)
  desconto       Decimal         @default(0) @db.Decimal(12, 2)
  // Oposto do desconto — soma ao total em vez de subtrair (ex: taxa de entrega, embalagem
  // especial cobrada à parte). total = subtotal dos itens - desconto + acrescimo.
  acrescimo      Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  confirmadaEm   DateTime?

  itens            ItemVenda[]
  contaReceber     ContaReceber?
  pagamentoPointMP PagamentoPointMP?
}

model Caixa {
  id        Int      @id @default(autoincrement())
  nome      String
  unidade   String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  // Integração Mercado Pago Point: cada caixa tem sua própria conta e maquininha.
  mpAccessTokenEnc String? // access token da conta MP, criptografado em repouso (ver src/utils/crypto.js)
  mpUserId         String? // user_id da conta MP dona do token
  mpNicknameConta  String? // nickname/email da conta MP, apenas para exibição
  mpDeviceId       String? // device_id da maquininha (Point Smart) associada a este caixa

  vendas               Venda[]
  contasPagar          ContaPagar[]
  contasReceber        ContaReceber[]
  pagamentosPointMP    PagamentoPointMP[]
  estoque              EstoqueCaixa[]
  movimentacoesEstoque MovimentacaoEstoque[]
  sessoes              SessaoCaixa[]
}

// Abertura/fechamento de caixa (sessão de turno): cada vez que um funcionário assume o
// caixa físico de uma unidade, ele conta o dinheiro e abre uma sessão; ao sair, conta de
// novo e fecha informando quanto deixou. valorEsperadoAbertura/divergenciaAbertura são
// travados no momento da abertura, comparando com o valorFechamento da sessão FECHADA mais
// recente daquele mesmo caixa — é o que alimenta o alerta de divergência pro admin.
model SessaoCaixa {
  id      Int               @id @default(autoincrement())
  caixaId Int
  caixa   Caixa             @relation(fields: [caixaId], references: [id])
  status  StatusSessaoCaixa @default(ABERTA)

  usuarioAberturaId Int
  usuarioAbertura   Usuario  @relation("SessaoCaixaAbertura", fields: [usuarioAberturaId], references: [id])
  valorAbertura     Decimal  @db.Decimal(12, 2)
  abertaEm          DateTime @default(now())

  usuarioFechamentoId  Int?
  usuarioFechamento    Usuario?  @relation("SessaoCaixaFechamento", fields: [usuarioFechamentoId], references: [id])
  valorFechamento      Decimal?  @db.Decimal(12, 2)
  fechadaEm            DateTime?
  observacaoFechamento String?

  valorEsperadoAbertura Decimal? @db.Decimal(12, 2)
  divergenciaAbertura   Decimal? @db.Decimal(12, 2)
  divergenciaRevisada   Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([caixaId, status])
  @@index([caixaId, fechadaEm])
}

model PagamentoPointMP {
  id              Int                    @id @default(autoincrement())
  vendaId         Int                    @unique
  venda           Venda                  @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  caixaId         Int
  caixa           Caixa                  @relation(fields: [caixaId], references: [id])
  deviceId        String
  paymentIntentId String                 @unique
  status          StatusPagamentoPointMP @default(PENDENTE)
  valor           Decimal                @db.Decimal(12, 2)
  detalhes        Json?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model ItemVenda {
  id         Int     @id @default(autoincrement())
  vendaId    Int
  venda      Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produtoId  Int
  produto    Produto @relation(fields: [produtoId], references: [id])
  // Quantidade DESTE NÍVEL vendida (ex: "2 caixas"), não em grão-base — ver
  // quantidadeGraoPorNivel para o total em grão-base.
  quantidade Int
  precoUnit  Decimal @db.Decimal(12, 2)

  // Nível de venda escolhido (ver NivelVendaProduto) — nullable só pra cobrir dado histórico
  // migrado de antes deste modelo existir, sem um nível correspondente exato.
  nivelVendaId Int?
  nivelVenda   NivelVendaProduto? @relation(fields: [nivelVendaId], references: [id])
  // Snapshot de NivelVendaProduto.quantidadeGrao no momento da venda — travado pra
  // relatórios/estoque continuarem corretos mesmo se o nível for editado depois.
  quantidadeGraoPorNivel Int

  // Snapshot de Produto.precoCusto (por grão-base) no momento da venda. Sem isso, mudar o
  // custo de um produto num recebimento novo mudaria retroativamente o custo — e o Lucro
  // Líquido — de vendas já feitas com o estoque antigo, mais barato. Custo de venda antiga
  // sempre usa o custo que valia quando ela aconteceu (ver custoVenda.js).
  custoUnit Decimal? @db.Decimal(12, 2)
}

model ContaReceber {
  id         Int       @id @default(autoincrement())
  clienteId  Int
  cliente    Cliente   @relation(fields: [clienteId], references: [id])
  vendaId    Int?      @unique
  venda      Venda?    @relation(fields: [vendaId], references: [id])
  caixaId    Int?
  caixa      Caixa?    @relation(fields: [caixaId], references: [id])
  valor      Decimal   @db.Decimal(12, 2)
  vencimento DateTime
  pago       Boolean   @default(false)
  pagoEm     DateTime?
  createdAt  DateTime  @default(now())

  // Conta fixa mensal: a linha original (recorrente=true) é o "template" — os meses
  // seguintes são projetados na hora de listar e só viram linha real quando pagos
  // (ver financeiro.controller.js). Instâncias materializadas apontam de volta pro template.
  recorrente         Boolean        @default(false)
  origemRecorrenteId Int?
  origemRecorrente   ContaReceber?  @relation("RecorrenciaContaReceber", fields: [origemRecorrenteId], references: [id])
  ocorrencias        ContaReceber[] @relation("RecorrenciaContaReceber")
}

model ContaPagar {
  id         Int       @id @default(autoincrement())
  descricao  String
  fornecedor String?
  caixaId    Int?
  caixa      Caixa?    @relation(fields: [caixaId], references: [id])
  valor      Decimal   @db.Decimal(12, 2)
  vencimento DateTime
  pago       Boolean   @default(false)
  pagoEm     DateTime?
  createdAt  DateTime  @default(now())

  recorrente         Boolean      @default(false)
  origemRecorrenteId Int?
  origemRecorrente   ContaPagar?  @relation("RecorrenciaContaPagar", fields: [origemRecorrenteId], references: [id])
  ocorrencias        ContaPagar[] @relation("RecorrenciaContaPagar")
}

// Análise de reposição gerada por IA (ver src/modules/analiseReposicao) — uma linha por
// semana (chave = segunda-feira daquela semana), em cache: a primeira requisição da semana
// que não encontra linha ainda gera via OpenAI e salva; as demais só leem. Nunca duas linhas
// pra mesma semana (unique em `data`).
model AnaliseReposicaoIA {
  id       Int      @id @default(autoincrement())
  data     DateTime @unique @db.Date
  resumo   String?
  itens    Json
  modelo   String?
  geradoEm DateTime @default(now())
}

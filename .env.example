DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
JWT_SECRET="troque-este-segredo-em-producao"
PORT=3001
CORS_ORIGIN="http://localhost:5173,https://ovosbastos.selfmachine.com.br"

# Cloudinary — upload de imagens dos produtos (Configuração > Access Keys no dashboard)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mercado Pago Point — cada caixa guarda seu próprio Access Token (conta) e device_id
# (maquininha), configurados via API em /api/caixas/:id/mercadopago/*.
# Chave usada para criptografar os Access Tokens no banco (AES-256-GCM, 32 bytes em base64).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MP_ENCRYPTION_KEY=""
# URL pública (https) deste backend, usada para o Mercado Pago notificar quando um pagamento
# na maquininha é aprovado/rejeitado. Sem isso, o pagamento continua funcionando mas o status
# só é atualizado quando o frontend consultar GET /api/vendas/:id/pagamento-maquininha.
APP_BASE_URL="https://seu-backend.exemplo.com"

# Análise de reposição por IA (card "Reposição recomendada" no Dashboard) — roda no máximo
# 1x por dia, em cache (ver AnaliseReposicaoIA / src/modules/analiseReposicao). Sem essa
# chave, o card cai automaticamente no cálculo determinístico de antes.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
